# PostgreSQL connection string (required)
# Local dev:  postgresql://postgres:postgres@localhost:5432/mlops_db
# Aiven:      postgresql://avnadmin:<pass>@pg-xxxxx.aivencloud.com:<port>/mlops_db?sslmode=require
# Render:     postgresql://user:pass@<host>/<db>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mlops_db

# CF model hyper-parameters (optional — defaults are production-ready)
CF_FACTORS=64
CF_ITERATIONS=50
CF_REGULARIZATION=0.01

# Cold-start threshold: min interactions before CF kicks in
MIN_INTERACTIONS_FOR_CF=3

# Retrain triggers
RETRAIN_EVERY_N_INTERACTIONS=50
RETRAIN_INTERVAL_SECONDS=3600

# Serving order: content_first = content -> CF -> popular (default)
# Set cf_first for CF -> content -> popular. Restart the service after changing.
# This does not disable CF training or change either retraining schedule.
RECOMMENDATION_PRIORITY=content_first

# Default recommendation count
TOP_N_RECOMMENDATIONS=20

# Content-based model artifacts directory & retraining
CONTENT_MODEL_DIR=app/data/content_model
CONTENT_RETRAIN_INTERVAL_SECONDS=86400
MIN_NEW_SONGS_FOR_CONTENT_RETRAIN=5

PORT=8000

# MySQL connection string (required for explainability pipeline — build_dataset.py)
# This is the Spring Boot MySQL database.
# Local dev:  mysql+pymysql://root:password@localhost:3306/mformusic_db
# Production: mysql+pymysql://user:pass@host:3306/mformusic_db
# MYSQL_URL=mysql+pymysql://root:password@localhost:3306/mformusic_db
